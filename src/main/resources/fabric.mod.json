{
	"schemaVersion": 1,
	"id": "bowcasting",
	"version": "${version}",
	"name": "bowcasting",
	"description": "A client-side Fabric mod that adds animated magical spell effects and dynamic lighting to bows.",
	"authors": [
		"tseileinn"
	],
	"contact": {
		"sources": "https://github.com/ArtemiszenN/Bowcasting"
	},
	"license": "MIT",
	"icon": "assets/bowcasting/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"tseileinn.bowcasting.Bowcasting"
		],
		"client": [
			"tseileinn.bowcasting.client.BowcastingClient"
		],
		"modmenu": [
			"tseileinn.bowcasting.client.BowcastingModMenu"
		],
		"lambdynlights:initializer": [
			"tseileinn.bowcasting.client.BowcastingDynamicLightsInitializer"
		]
	},
	"mixins": [
		"bowcasting.mixins.json",
		{
			"config": "bowcasting.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}